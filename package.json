{
  "name": "wireless-canvas",
  "version": "1.0.1",
  "description": "DY Canvas - Offline canvas for presentations and knowledge organization",
  "author": "Wireless Canvas",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "predist:win": "node node_modules/electron/install.js",
    "dist:win": "node desktop/build-windows.cjs",
    "prepack:win": "node node_modules/electron/install.js",
    "pack:win": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.local.wirelesscanvas",
    "productName": "DY画布",
    "executableName": "WirelessCanvas",
    "asar": true,
    "compression": "maximum",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "release", "buildResources": "desktop" },
    "files": [
      "index.html", "app.js", "workspace-features.js", "style.css",
      "media/**/*", "vendor/**/*", "desktop/main.cjs", "desktop/preload.cjs",
      "desktop/icon.png", "package.json", "README.md", "docs/user-guide.md",
      "CHANGELOG.md", "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "desktop/icon.ico",
      "artifactName": "DYCanvas-Setup-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DY画布",
      "uninstallDisplayName": "DY画布",
      "installerLanguages": ["zh_CN", "en_US"],
      "displayLanguageSelector": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
